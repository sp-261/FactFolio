# Same layers as ../Dockerfile, with every package at its uv.lock version and CPU-only torch.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    RAG_PROFILE=server HF_HOME=/app/indexes/hf_cache HOME=/tmp/app-home
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml uv.lock deploy/requirements_from_pyproject.py /tmp/build/
RUN cd /tmp/build \
 && pip install uv \
 && uv export --frozen --no-dev --no-hashes --no-emit-project -q > lock.txt \
 && python requirements_from_pyproject.py pyproject.toml > requirements.txt \
 && pip install --index-url https://download.pytorch.org/whl/cpu torch==2.14.1 torchvision==0.29.1 \
 && grep -v -E '^(torch|torchvision|nvidia-|triton)' lock.txt > lock_cpu.txt \
 && pip install -r requirements.txt -c lock_cpu.txt \
 && rm -rf /tmp/build
COPY scripts ./scripts
COPY configs ./configs
COPY deploy ./deploy
COPY data ./data
COPY pyproject.toml ./
RUN mkdir -p /app/indexes /app/output /tmp/app-home && chmod -R a+rwX /app/indexes /app/output /tmp/app-home
EXPOSE 8000 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/health || curl -fsS http://127.0.0.1:8501/_stcore/health || exit 1
CMD ["uvicorn", "scripts.api.api_app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]